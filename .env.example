# Copier ce fichier vers .env et remplir les vraies valeurs.
# Le fichier .env ne doit JAMAIS être commité (voir .gitignore).

OLLAMA_URL=http://localhost:11434
OLLAMA_KEY=
OLLAMA_MODEL=llama3:latest
# Maintien du modèle en mémoire GPU. « -1 » le garde en permanence : sans cela
# Ollama le décharge après 5 min et le client suivant attend son rechargement.
OLLAMA_KEEP_ALIVE=-1

# Plafond de scans par cible et par 24 h (CDC §7.1). 0 désactive la limite.
QUOTA_SCANS_PAR_CIBLE=0
JWT_SECRET_KEY=générer-une-clé-aléatoire-longue

# Comptes créés par seed.py. Laisser vide fait tirer un mot de passe au sort,
# affiché une seule fois à l'exécution. Ne jamais renseigner ces valeurs ici :
# ce fichier est versionné, .env ne l'est pas.
SEED_ADMIN_PASSWORD=
SEED_EXPERT_PASSWORD=
SEED_CLIENT_PASSWORD=

# Chiffrement au repos des secrets en base (jeton OAuth GitHub).
# Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# PostgreSQL (valeurs par défaut dans database.py)
DB_USER=cguser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyberguardian

# Bot Telegram (liaison de compte + notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CyberGuardianBot
TELEGRAM_WEBHOOK_SECRET=

# OAuth GitHub (remédiation assistée par Pull Request)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_BASE_URL=
FRONTEND_URL=http://localhost:5173

# Réputation (5e critère du score). Clés gratuites après inscription :
#   https://www.virustotal.com/gui/my-apikey
#   https://www.abuseipdb.com/account/api
# Laissées vides, le critère est exclu du score au lieu d'être compté à zéro.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Canaux de notification additionnels (Apprise, services/notifications.py) :
# URLs séparées par des virgules. Vide par défaut : seul Telegram est utilisé.
# Exemple : APPRISE_URLS=mailto://user:motdepasse@gmail.com
APPRISE_URLS=
