# Copier ce fichier vers .env et remplir les vraies valeurs.
# Le fichier .env ne doit JAMAIS être commité (voir .gitignore).

OLLAMA_URL=http://localhost:11434
OLLAMA_KEY=
OLLAMA_MODEL=llama3:latest
# Maintien du modèle en mémoire GPU. « -1 » le garde en permanence : sans cela
# Ollama le décharge après 5 min et le client suivant attend son rechargement.
OLLAMA_KEEP_ALIVE=-1

# Plafond de scans par cible et par 24 h (CDC §7.1). 0 désactive la limite.
QUOTA_SCANS_PAR_CIBLE=0
JWT_SECRET_KEY=générer-une-clé-aléatoire-longue

# Comptes créés par seed.py. Laisser vide fait tirer un mot de passe au sort,
# affiché une seule fois à l'exécution. Ne jamais renseigner ces valeurs ici :
# ce fichier est versionné, .env ne l'est pas.
SEED_ADMIN_PASSWORD=
SEED_EXPERT_PASSWORD=
SEED_CLIENT_PASSWORD=

# Chiffrement au repos des secrets en base (jeton OAuth GitHub).
# Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# PostgreSQL (valeurs par défaut dans database.py)
DB_USER=cguser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyberguardian

# Bot Telegram (liaison de compte + notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CyberGuardianBot
TELEGRAM_WEBHOOK_SECRET=

# OAuth GitHub (remédiation assistée par Pull Request)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_BASE_URL=
FRONTEND_URL=http://localhost:5173

# Réputation (5e critère du score). Clés gratuites après inscription :
#   https://www.virustotal.com/gui/my-apikey
#   https://www.abuseipdb.com/account/api
# Laissées vides, le critère est exclu du score au lieu d'être compté à zéro.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Canaux de notification additionnels (Apprise).
# Telegram est déjà géré par utilisateur : chacun lie son compte depuis ses
# paramètres et reçoit ses propres alertes. Cette liste sert aux canaux communs,
# qui reçoivent les notifications de tous les comptes, typiquement une adresse
# ou un salon d'équipe. Plusieurs URLs séparées par des virgules.
#
#   mailto://compte:motdepasse@gmail.com
#   slack://jeton_a/jeton_b/jeton_c/#securite
#   discord://identifiant_webhook/jeton_webhook
#   mmost://serveur.exemple.sn/jeton     (Mattermost auto-hébergé)
#
# Liste complète des services : https://github.com/caronc/apprise/wiki
APPRISE_URLS=

# Compte d'envoi des alertes par e-mail. Comme Telegram, ce canal est personnel :
# chaque client reçoit ses alertes à l'adresse de son compte, et peut les couper
# depuis ses paramètres. Le compte ci-dessous est celui de la plateforme, jamais
# celui d'un client — aucun utilisateur ne saisit de mot de passe de messagerie.
#
# Avec Gmail, SMTP_PASSWORD est un mot de passe d'application (16 caractères),
# pas le mot de passe du compte, et la validation en deux étapes doit être
# activée : https://myaccount.google.com/apppasswords
#
# Sans SMTP_HOST, le canal e-mail est absent et les alertes partent uniquement
# sur Telegram.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
